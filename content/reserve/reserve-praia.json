  "paragraphs": [
    [
      {
        "pt": "É [[verão|verao]] e a família vai à [[praia|praia]].",
        "fr": "C’est l’été et la famille va à la plage."
      },
      {
        "pt": "O [[mar|mar]] está [[calmo|calmo]] e a água está fria.",
        "fr": "La mer est calme et l’eau est froide."
      },
      {
        "pt": "O pai [[põe|por]] o guarda-sol na [[areia|areia]].",
        "fr": "Le père plante le parasol dans le sable."
      }
    ],
    [
      {
        "pt": "A Marta [[nada|nadar]] com o irmão.",
        "fr": "Marta nage avec son frère."
      },
      {
        "pt": "Ao almoço, comem peixe grelhado.",
        "fr": "À midi, ils mangent du poisson grillé."
      },
      {
        "pt": "À tarde, todos [[descansam|descansar]] ao sol.",
        "fr": "L’après-midi, tout le monde se repose au soleil."
      }
    ]
  ],
